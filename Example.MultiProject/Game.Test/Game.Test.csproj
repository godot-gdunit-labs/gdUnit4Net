<Project Sdk="Godot.NET.Sdk">
    <PropertyGroup>
        <!-- Disable Central Package Management for Godot projects -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Game.Test</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <!-- Disable the warning of an incompatible GodotSharp version between the Godot SDK and the gdUnit4 API -->
        <NoWarn>NU1605</NoWarn>
        <!-- Prevent MSTest adapter from being discovered -->
        <VSTestTestAdapterPath>none</VSTestTestAdapterPath>
        <TestFramework>GdUnit4</TestFramework>
        <RunSettingsFilePath>$(MSBuildProjectDirectory)/.runsettings</RunSettingsFilePath>
    </PropertyGroup>

    <ItemGroup>
        <!-- The game project: gdUnit4 mounts its resources, scenes and settings at test runtime -->
        <ProjectReference Include="../Game/Game.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1"/>
        <!--
        The example tests the gdUnit4 sources of this repository. A project of your own references the packages instead:
        <PackageReference Include="gdUnit4.api" Version="..."/>
        <PackageReference Include="gdUnit4.test.adapter" Version="..."/>
        -->
        <ProjectReference Include="../../Api/GdUnit4Api.csproj"/>
        <ProjectReference Include="../../TestAdapter/GdUnit4TestAdapter.csproj"/>
    </ItemGroup>

    <!-- The gdUnit4.api package imports these targets, a project reference does not -->
    <Import Project="../../Api/build/gdUnit4.api.targets"/>
</Project>
