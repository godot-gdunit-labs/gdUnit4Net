<Project>
  <!-- GdUnit4 Component Versions -->
  <PropertyGroup>
    <GdUnitAnalyzersVersion>1.0.0</GdUnitAnalyzersVersion>
    <GdUnitAPIVersion>5.1.0-rc5</GdUnitAPIVersion>
    <GdUnitTestAdapterVersion>3.1.1</GdUnitTestAdapterVersion>
  </PropertyGroup>

  <!-- Code Analyzers (also referenced by the Godot test project, which cannot use Central Package Management) -->
  <PropertyGroup>
    <StyleCopAnalyzersVersion>1.2.0-beta.556</StyleCopAnalyzersVersion>
    <MicrosoftCodeAnalysisAnalyzersVersion>4.14.0</MicrosoftCodeAnalysisAnalyzersVersion>
  </PropertyGroup>

  <!-- Godot Configuration -->
  <PropertyGroup>
    <!-- Note: Keep GodotVersion in sync with global.json msbuild-sdks.Godot.NET.Sdk -->
    <GodotVersion>4.4</GodotVersion>
    <GodotNetSdkVersion>$(GodotVersion)</GodotNetSdkVersion>
  </PropertyGroup>

  <!-- Common Build Properties -->
  <PropertyGroup>
    <CommonTargetFrameworks Condition="'$(CommonTargetFrameworks)' == ''">net8.0;net9.0</CommonTargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType Condition="'$(DebugType)' == ''">portable</DebugType>
  </PropertyGroup>
</Project>
