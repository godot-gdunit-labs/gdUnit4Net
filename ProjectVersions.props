<Project>
  <!-- GdUnit4 Component Versions -->
  <PropertyGroup>
    <GdUnitAnalyzersVersion>1.1.0</GdUnitAnalyzersVersion>
    <GdUnitAPIVersion>5.1.0-rc7</GdUnitAPIVersion>
    <GdUnitTestAdapterVersion>3.2.0</GdUnitTestAdapterVersion>
  </PropertyGroup>

  <!-- Code Analyzers (also referenced by the Godot test project, which cannot use Central Package Management) -->
  <PropertyGroup>
    <StyleCopAnalyzersVersion>1.2.0-beta.556</StyleCopAnalyzersVersion>
    <!-- Keep Microsoft.CodeAnalysis.Analyzers on the compiler version of the .NET SDK in global.json -->
    <MicrosoftCodeAnalysisAnalyzersVersion>5.9.0</MicrosoftCodeAnalysisAnalyzersVersion>
    <!--
    The analyzers run only in a compiler at least as new as the Roslyn version they are built against.
    Keep it on Roslyn 4.8, which ships with the .NET SDK 8.0.100 and Visual Studio 17.8, the oldest toolchain of net8.0.
    -->
    <AnalyzersRoslynVersion>4.8.0</AnalyzersRoslynVersion>
  </PropertyGroup>

  <!-- Test Packages (also referenced by the Godot test project, which cannot use Central Package Management) -->
  <PropertyGroup>
    <MicrosoftNETTestSdkVersion>18.0.1</MicrosoftNETTestSdkVersion>
    <MSTestTestFrameworkVersion>3.10.4</MSTestTestFrameworkVersion>
    <MoqVersion>4.20.72</MoqVersion>
  </PropertyGroup>

  <!-- Godot Configuration -->
  <PropertyGroup>
    <!-- Note: Keep GodotVersion in sync with global.json msbuild-sdks.Godot.NET.Sdk -->
    <GodotVersion>4.7</GodotVersion>
    <GodotNetSdkVersion>$(GodotVersion)</GodotNetSdkVersion>
  </PropertyGroup>

  <!-- Target Frameworks and Language Version -->
  <PropertyGroup>
    <CommonTargetFrameworks Condition="'$(CommonTargetFrameworks)' == ''">net8.0;net10.0</CommonTargetFrameworks>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
</Project>
