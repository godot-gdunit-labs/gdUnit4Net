<Project>
  <!-- Apply the repository build settings (analyzers, StyleCop, warnings as errors) to this Godot test project -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <PropertyGroup>
    <!-- Relaxed rules for test code, like the other test projects -->
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)test.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Godot projects cannot use Central Package Management, so the analyzer versions are set here -->
  <ItemGroup>
    <PackageReference Update="StyleCop.Analyzers" Version="$(StyleCopAnalyzersVersion)"/>
    <PackageReference Update="Microsoft.CodeAnalysis.Analyzers" Version="$(MicrosoftCodeAnalysisAnalyzersVersion)"/>
  </ItemGroup>
</Project>
